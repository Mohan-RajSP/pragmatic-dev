# =========================================================
# Pragmatic-dev Backend — environment variables (example)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# =========================================================

# --- Application ---
APP_NAME=pragmatic-dev-backend
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# e.g. "/api/v1" for versioned paths; leave empty for root
API_PREFIX=

# --- CORS (comma-separated origins; "*" for all in dev) ---
CORS_ORIGINS=*

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Tips feature (keys + limits) ---
TIPS_LIST_KEY=tips:list
TIPS_TRIGGER_KEY=tips:trigger
TIPS_MAX_ITEMS=10
# seconds between Redis reads on the SSE stream
TIP_STREAM_POLL_INTERVAL=2.0
# seconds between SSE keepalive heartbeats
SSE_HEARTBEAT_INTERVAL=15.0

# Cold-start: force an immediate tip when the cache is empty
# Celery task name (contract with the worker)
TIP_GENERATION_TASK=tips.generate
TIP_BOOTSTRAP_LOCK_KEY=tips:bootstrap:lock
# seconds; de-dupes concurrent cold-start dispatches
TIP_BOOTSTRAP_LOCK_TTL=30

# --- Celery (defaults to REDIS_* above when left blank) ---
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Chat feature ---
CHAT_PENDING_KEY_PREFIX=chat:pending:
# seconds a submitted message stays claimable
CHAT_PENDING_TTL=60

# --- LLM (strategy pattern) ---
# strategy selector
LLM_PROVIDER=openai
# e.g. gpt-4o-mini (cheap) or gpt-4o (better chat)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
# <-- put your OpenAI API key here
OPENAI_API_KEY=sk-replace-me


