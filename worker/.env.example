# =========================================================
# Pragmatic-dev Worker — environment variables (example)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
#
# Keep comments on their OWN lines — python-dotenv keeps inline "# ..." text as
# part of the value, which breaks numeric fields.
# =========================================================

# --- Application ---
APP_NAME=pragmatic-dev-worker
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Redis (cache; also default broker/backend) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Celery (defaults to REDIS_* above when left blank) ---
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Tips generation ---
TIPS_LIST_KEY=tips:list
TIPS_TRIGGER_KEY=tips:trigger
TIPS_MAX_ITEMS=10
# Beat cadence in seconds (300 = 5 minutes)
TIP_SCHEDULE_SECONDS=300
# Scheduled message expires if not run in time (< cadence)
TIP_TASK_EXPIRES=270

# --- Mutual exclusion + retry backoff ---
TIPS_LOCK_KEY=tips:generation:lock
# Seconds; lock auto-expires if a worker dies
TIPS_LOCK_TTL=120
TIPS_RETRY_MARKER_KEY=tips:retry:in_progress
# Marker TTL = retry countdown + this buffer
TIP_RETRY_MARKER_BUFFER=30
# Hard cap on retry attempts
TIP_MAX_RETRIES=3
# Seconds; first retry delay (doubles each retry)
TIP_RETRY_BASE_DELAY=10
# Cap on exponential backoff
TIP_RETRY_MAX_DELAY=600

# --- LLM (strategy pattern) ---
LLM_PROVIDER=openai
# cheap + fast; fine for one-line tips
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.8
# <-- put your OpenAI API key here
OPENAI_API_KEY=test
